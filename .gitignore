# ---- generated by the render/sound pipeline (regenerable, never committed) ----
demo/*/out/
demo/*/assets/sound.wav
demo/*/index-*.png
demo/*/*.spec.png
demo/*/.om/

# ---- development-only documents: kept locally, never published (workspace rule 5) ----
DEVELOPMENT.md
ERROR.md

# ---- local tooling ----
node_modules/
*.log
.DS_Store
Thumbs.db
.venv/
__pycache__/

# ---- scratch ----
_scratch/
.scratch/
